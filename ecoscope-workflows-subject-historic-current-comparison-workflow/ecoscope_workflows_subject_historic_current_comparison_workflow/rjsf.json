{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set Workflow Details"
    },
    "er_connection": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to EarthRanger"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Set Time Range"
    },
    "segment_filter": {
      "additionalProperties": false,
      "properties": {
        "min_length_meters": {
          "default": 0.001,
          "title": "Min Length Meters",
          "type": "number",
          "description": "Minimum segment length in meters.",
          "ecoscope:advanced": true
        },
        "max_length_meters": {
          "default": 5000,
          "title": "Max Length Meters",
          "type": "number",
          "description": "Maximum segment length in meters.",
          "ecoscope:advanced": true
        },
        "min_time_secs": {
          "default": 1,
          "title": "Min Time Secs",
          "type": "number",
          "description": "Minimum segment duration in seconds.",
          "ecoscope:advanced": true
        },
        "max_time_secs": {
          "default": 21600,
          "title": "Max Time Secs",
          "type": "number",
          "description": "Maximum segment duration in seconds.",
          "ecoscope:advanced": true
        },
        "min_speed_kmhr": {
          "default": 0.01,
          "title": "Min Speed Kmhr",
          "type": "number",
          "description": "Minimum segment speed in km/h.",
          "ecoscope:advanced": true
        },
        "max_speed_kmhr": {
          "default": 9.0,
          "title": "Max Speed Kmhr",
          "type": "number",
          "description": "Maximum segment speed in km/h.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Trajectory Segment Filter"
    },
    "Subject Group": {
      "type": "object",
      "description": "Choose subject group to analyze",
      "ecoscope:task_group": true,
      "properties": {
        "subject_group_name": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Subject Group Name",
              "type": "string",
              "description": "The EarthRanger subject group to map, picked from the chosen data source's subject groups.",
              "ecoscope:transform": [
                {
                  "transformer": "EarthRangerEnumResolver",
                  "transformer_kws": {
                    "type": "subject_group_name",
                    "depends_on": "properties.er_connection.properties.data_source.properties.name"
                  }
                }
              ]
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        }
      }
    },
    "base_maps_pydeck": {
      "additionalProperties": false,
      "properties": {
        "base_maps": {
          "default": [
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
              "opacity": 1,
              "max_zoom": 20,
              "min_zoom": 0
            },
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
              "opacity": 0.5,
              "max_zoom": 20,
              "min_zoom": 0
            }
          ],
          "items": {
            "title": "Base Layer",
            "anyOf": [
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "enum": [
                      "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Open Street Map",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Roadmap",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Satellite",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Terrain",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "USGS Hillshade",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://example.tiles.com/{z}/{x}/{y}.png",
                    "description": "The URL of a publicly accessible tiled raster service.",
                    "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}([-a-zA-Z0-9()@:%_\\+.~#?&//=\\{\\}]*)",
                    "title": "Custom Layer URL",
                    "type": "string"
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Custom Layer Opacity",
                    "type": "number"
                  },
                  "max_zoom": {
                    "default": 20,
                    "description": "Set the maximum zoom level to fetch tiles for.",
                    "title": "Custom Layer Max Zoom",
                    "type": "integer"
                  },
                  "min_zoom": {
                    "default": 0,
                    "description": "Set the minimum zoom level to fetch tiles for.",
                    "title": "Custom Layer Min Zoom",
                    "type": "integer"
                  }
                },
                "title": "Custom Layer (Advanced)",
                "type": "object"
              }
            ]
          },
          "title": " ",
          "type": "array",
          "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Base Maps"
    },
    "previous_time_range": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetPreviousPeriod"
            },
            {
              "$ref": "#/$defs/CustomPreviousPeriod"
            },
            {
              "$ref": "#/$defs/CalendarPreviousPeriod"
            }
          ],
          "title": "Comparison Period Length",
          "description": "How far back the comparison period starts: a preset (e.g. the same length as the current period), a custom offset, or a start date picked on the calendar.",
          "default": {
            "preset": "Same as current period"
          }
        }
      },
      "required": [
        "offset"
      ],
      "type": "object",
      "title": "Comparison Period",
      "description": "The earlier period whose tracks are drawn as comparison tracks (grey and under the current tracks by default). It always ends where the current time range starts."
    },
    "Track Order and Colors": {
      "type": "object",
      "description": "The colours for historic and current tracks, and which draw on top where they overlap.",
      "ecoscope:task_group": true,
      "properties": {
        "status_color_columns": {
          "additionalProperties": false,
          "properties": {
            "previous_color_hex": {
              "title": "Historic Tracks Color",
              "type": "string",
              "format": "color",
              "default": "#a9a9a9",
              "description": "Colour of the tracks from the historic period."
            },
            "use_hex_column_for_current": {
              "title": "Use subject colors for current tracks",
              "type": "boolean",
              "default": true,
              "description": "Colour each subject's current tracks with its EarthRanger colour. Untick to use the Current Tracks Color below for every subject."
            },
            "default_current_hex": {
              "title": "Current Tracks Color",
              "type": "string",
              "format": "color",
              "default": "#6495ed",
              "description": "Colour of the current tracks when \"Use subject colors for current tracks\" is unticked."
            }
          },
          "required": [
            "previous_color_hex"
          ],
          "type": "object",
          "title": "Track Colors"
        },
        "sort_values_by_status": {
          "additionalProperties": false,
          "properties": {
            "ascending": {
              "title": "Current tracks on top",
              "type": "boolean",
              "default": true,
              "description": "Draw current tracks over historic tracks where they overlap. Untick to draw historic tracks on top."
            }
          },
          "required": [],
          "type": "object",
          "title": "Track Order"
        }
      }
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "CalendarPreviousPeriod": {
      "properties": {
        "since": {
          "description": "Select the start date for the comparison period.",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        }
      },
      "required": [
        "since"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "CustomPreviousPeriod": {
      "properties": {
        "years": {
          "default": 0,
          "title": "Years",
          "type": "integer"
        },
        "months": {
          "default": 0,
          "title": "Months",
          "type": "integer"
        },
        "weeks": {
          "default": 0,
          "title": "Weeks",
          "type": "integer"
        },
        "days": {
          "default": 0,
          "title": "Days",
          "type": "integer"
        },
        "hours": {
          "default": 0,
          "title": "Hours",
          "type": "integer"
        },
        "minutes": {
          "default": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "seconds": {
          "default": 0,
          "title": "Seconds",
          "type": "integer"
        }
      },
      "title": "Custom",
      "type": "object"
    },
    "PresetPreviousPeriod": {
      "properties": {
        "preset": {
          "default": "Same as current period",
          "description": "Choose a predefined time offset.",
          "enum": [
            "Same as current period",
            "1 month back",
            "3 months back",
            "6 months back",
            "1 year back"
          ],
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "Preset",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "segment_filter": {
      "ui:order": [
        "min_length_meters",
        "max_length_meters",
        "min_time_secs",
        "max_time_secs",
        "min_speed_kmhr",
        "max_speed_kmhr"
      ]
    },
    "Track Order and Colors": {
      "ui:order": [
        "status_color_columns",
        "sort_values_by_status"
      ],
      "status_color_columns": {
        "ui:order": [
          "previous_color_hex",
          "use_hex_column_for_current",
          "default_current_hex"
        ]
      }
    },
    "ui:order": [
      "workflow_details",
      "er_connection",
      "time_range",
      "segment_filter",
      "Subject Group",
      "base_maps_pydeck",
      "previous_time_range",
      "Track Order and Colors"
    ]
  },
  "additionalProperties": false
}
